<%- include("../partials/header") %>
<%- include("../partials/nav") %>
<div class="container mt-5">
    <h2>Order Histoy</h2>
    <table class="table table-bordered mt-4 text-center">
        <thead class="table-light">
            <tr>
                <th>Order #</th>
                <th>User</th>
                <th>Total Price</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            <% orders.forEach(o=>{ %>
            <tr>
                <td><%=o.order_no%></td>
                <td><%=o.first_name%> <%= o.last_name %></td>
                <td>$<%= o.total_price %></td>
                <td><%=o.order_date%></td>
            </tr>
           <% }) %>
        </tbody>
    </table>
</div>
<%- include("../partials/footer") %>