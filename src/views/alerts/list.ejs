<%- include("../partials/header") %>

<div class="container mt-5">
    <h2 class="mb-4">Alerts!</h2>

    <ul class="list-group">
        <% alerts.forEach(a => { %>
            <li class="list-group-item d-flex justify-content-between">
                <span><%= a.description %></span>
                <span><%=a.date %></span>
            </li>
        <% }) %>
    </ul>
</div>
<%- include("../partials/footer") %>