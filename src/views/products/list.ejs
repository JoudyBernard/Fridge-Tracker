<%- include ("../partials/header") %>

<div class="container mt-5">
    <h2 class="mb-4">My Products</h2>

    <table class="table table-bordered text-center">
        <thead class="table-light">
            <tr>
                <th>Products</th>
                <th>Quantity</th>
                <th>Restock limit</th>
            </tr>
        </thead>
        <tbody>
            <% products.forEach(p => { %>
                <tr>
                    <td><%=p.prod_name %></td>
                    <td><%=p.quantity %></td>
                    <td><%=p.restock_limit %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<%- include ("../partials/footer") %>