<%- include("../partials/header") %>
<%- include("../partials/nav") %>
<div class="container mt-4">
    <h2><%= fridge? 'Edit Fridge' : 'Create New Fridge' %></h2>
    <form action="<%= fridge ? '/fridges/' + fridge.f_id + '?_method=PUT' : '/fridges' %>" method ="POST">
    <div class="mb-3">
        <label class="form-label">Fridge Name</label>
        <input type="text" name="f_name" class="form-control"
                value="<%= fridge? fridge.f_name: '' %>" required>
    </div>
    <div class="mb-3">
         <label class="form-label">Location</label>
         <input type="text" name="location" class="form-control"
                value="<%= fridge? fridge.location: '' %>" required>
    </div>
     <div class="mb-3">
         <label class="form-label">Restock Limit</label>
         <input type="number" min="0" name="restock_limit" class="form-control"
                value="<%= fridge? fridge.restock_limit: '' %>" required>
    </div>
    <button class="btn btn-primary">
        <%= fridge? 'Update Fridge' : 'Create Fridge' %>
    </button>
    <a href="/fridges" class="btn btn-secondary">Cancel</a>
    </form>
</div>
<%- include("../partials/footer") %>