<%- include("../partials/header") %>
<div class="container mt-4">
    <h2>Manage Fridge: <%= fridge.f_name %></h2>
    <div class="card mb-4">
        <div class="card-body">
            <p><strong>Id:</strong> <%=fridge.f_id %></p>
            <p><strong>Location:</strong> <%=fridge.location %></p>
            <p><strong>Restock Limit:</strong> <%=fridge.restock_limit %></p>
        </div>
    </div>
    <h4>Items in this fridge</h4>
    <% if(items.length === 0){ %>
        <p class="text-muted">No items found.</p>
    <% } else { %>
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Decrease</th>
                </tr>
            </thead>
            <tbody>
                <% items.forEach(item => { %>
                <tr>
                    <td><%= item.prod_name %></td>
                    <td><%= item.quantity %></td>
                    <td>
                        <form action="/fridges/<%= fridge.f_id%>/decrement/<%= item.prod_id %>" method="POST">
                            <button class = "btn btn-danger btn-sm">-1</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
    <a href="/fridges" class="btn btn-secondary mt-3">Back</a>
</div>
<%- include("../partials/footer") %>
